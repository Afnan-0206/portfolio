# Environment Variables
# Copy this file to .env.local and update values as needed

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Afnan Portfolio

# ========================================================
# OPTION A: Google App Password (Direct SMTP)
# ========================================================
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=brafnan26@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ========================================================
# OPTION B: Web3Forms (No Google Password Needed!)
# ========================================================
# Completely free, zero Google passwords required.
# 1. Enter your email at https://web3forms.com
# 2. Paste the access key emailed to you below:
# WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ========================================================
# OPTION C: Resend API (Alternative)
# ========================================================
# RESEND_API_KEY=re_your_api_key_here

# Social Links (Optional)
NEXT_PUBLIC_TWITTER=https://twitter.com/yourhandle
NEXT_PUBLIC_GITHUB=https://github.com/Afnan-0206
NEXT_PUBLIC_LINKEDIN=https://linkedin.com/in/afnan-391912363
